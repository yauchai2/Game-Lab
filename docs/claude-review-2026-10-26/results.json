    "version": "0.60.0",
    "intro": [
      [
        "下午三點的錯頻",
        "夏日街區還在過它平常的一天。小禾忙著修風扇，阿澄的渡船剛靠岸。街角電台卻突然播出一段沒有人點過的旋律。"
      ],
      [
        "會跟著節拍跑的雜物",
        "販賣機開始找錯零，路邊的雜物也跟著旋律亂跑。小禾發現，異常訊號正沿著舊電纜往高架橋的另一頭傳。先把前街清出一條路，再找出那段聲音從哪裡來。"
      ],
      [
        "把街區接回來",
        "阿澄在港口等你的消息，小禾留在電台接應。帶上熟悉的裝置，從前街開始追查。選擇你的職業，以自己的名字，把街區的聲音一段段接回來。"
      ]
    ],
    "stories": [
      [
        "潮聲裡的呼號",
        "渡船員 阿澄",
        "海邊的樹下掛著一台小收音機，同一段旋律被潮聲蓋了一半。阿澄說，靠岸的人都哼過它。",
        "巨像倒下後，收音機清楚地說了一句：下一班船，準時靠岸。"
      ],
      [
        "山路上的天線",
        "巡山員 留言",
        "山路旁的路牌曬得褪了色，風一吹，電線桿頂的天線跟著轉。跟著它轉的方向走就對了。",
        "BOSS胸口掉出一張車票。背面用原子筆寫著：電台前街，請走中間那條。"
      ],
      [
        "河灣的晚班",
        "渡船員 阿澄",
        "河邊的靠岸燈傍晚才亮，像在等最後一位乘客。船家把汽水留在欄杆上，說是請路過的人喝。",
        "水面靜下來後，遠處傳來有人試著對這一帶打招呼的聲音。"
      ],
      [
        "盆地裡的回音",
        "修理工 小禾",
        "這一帶的鐘全停在同一分鐘。小禾蹲在電箱旁，說地下電纜偶爾會傳來像腳步的脈衝。",
        "電纜重新亮起了一小段，訊號向山那邊延伸。"
      ],
      [
        "海岸的備忘錄",
        "渡船員 阿澄",
        "海風帶來另一個街區的聲音。別丟掉舊卡匣，說不定裡面留著某人的地址。",
        "BOSS終於停止巡邏。遠方海岸亮起一盞很小的燈。"
      ],
      [
        "沒有打烊的街",
        "鄰居廣播",
        "午後的街上，電單車的方向燈還在閃，招牌也亮著。這一帶好像還沒到收工的時間。",
        "街角喇叭播出了一段走調的收工音樂，聽起來反而有點親切。"
      ],
      [
        "營火旁的地圖",
        "修理工 小禾",
        "帳篷裡的地圖圈著同一個街角。大家說，只要電台還亮，迷路的人就不算失蹤。",
        "營地的短波機又響了。這次，另一端有人回答。"
      ],
      [
        "舊城的約定",
        "鐘樓留言",
        "廣場上的長椅留著一個空位。每到黃昏，修理工們會在這裡交換零件，也交換消息。",
        "鐘樓響了一次，像有人終於記起了約定。"
      ],
      [
        "風仍記得名字",
        "巡山員 留言",
        "風車替空下來的村子發電。小禾說，別讓它停，那是通往電台的路標。",
        "風車重新對準了電台的方向。被雜音蓋住的呼號清楚了一點。"
      ],
      [
        "雪線以外",
        "巡山員 留言",
        "雪埋住了高處與低處之間的舊路。電台仍在播放，卻沒有收到回程的訊號。",
        "雪裡露出一塊路牌：回程請沿燈光前進。"
      ],
      [
        "石柱間的雜音",
        "修理工 小禾",
        "這些石柱比電台更古老。卡匣靠近時會發熱，像是這個地方也記得昔日的聲音。",
        "石拱之間傳來短短三聲。那是舊時代表示平安的暗號。"
      ],
      [
        "最後一批貨物",
        "倉庫值班紀錄",
        "貨倉裡剩下一批沒送出的收音機。搬運機照著排程等著，等一班晚點的貨車。",
        "貨倉門開了。箱子上寫著：送往各個街角，讓大家聽得見彼此。"
      ]
    ],
