  "fieldStories": [
    [
      "潮聲裡的呼號",
      "渡船員 阿澄",
      "停電後第七年，海邊的樹仍替電台擋風。有人把回家的頻率刻在樹幹上。",
      "巨像倒下時，舊收音機傳來一句：下一班船，還會回來。"
    ],
    [
      "山路沒有盡頭",
      "巡山員 留言",
      "山丘上的路牌已經褪色。跟著風聲走，能找到仍在轉動的天線。",
      "BOSS胸口掉出一張車票。終點寫著：山頂電台。"
    ],
    [
      "河灣的晚班",
      "渡船員 阿澄",
      "河水淹過了舊月台。那盞靠岸燈一直亮著，像在等最後一位乘客。",
      "水面靜下來後，你聽見遠處有人試著呼叫這座島。"
    ],
    [
      "盆地裡的回音",
      "修理工 小禾",
      "所有鐘都停在同一分鐘。只有地下電纜，偶爾還會傳來腳步般的脈衝。",
      "電纜重新亮起了一小段。訊號向山那邊延伸。"
    ],
    [
      "海岸的備忘錄",
      "渡船員 阿澄",
      "海風帶來別座島的聲音。別丟掉舊卡匣，也許裡面還留著某人的地址。",
      "BOSS終於停止巡邏。遠方海岸亮起一盞很小的燈。"
    ],
    [
      "沒有關門的城市",
      "鄰居廣播",
      "樓宇裡已經沒有人，街角電單車的方向燈卻仍在閃。這座城似乎還沒下班。",
      "街角喇叭播出了一段走調的收工音樂。"
    ],
    [
      "營火熄滅之後",
      "修理工 小禾",
      "帳篷裡的地圖圈著同一座山。大家說，只要電台還亮，迷路的人就不算失蹤。",
      "營地的短波機又響了。這次，另一端有人回答。"
    ],
    [
      "舊城的約定",
      "鐘樓留言",
      "廣場上的長椅留著一個空位。從前每逢黃昏，修理工們會在這裡交換零件與消息。",
      "鐘樓響了一次，像有人終於記起了約定。"
    ],
    [
      "風仍記得名字",
      "巡山員 留言",
      "風車替早已空掉的村子發電。小禾說，別停下它，那是通往山頂的路標。",
      "風車重新對準了山頂。被雜音蓋住的呼號清楚了一點。"
    ],
    [
      "雪線以外",
      "巡山員 留言",
      "雪埋住了高山與低谷之間的舊路。山頂電台仍亮著，卻沒有收到任何回程訊號。",
      "雪裡露出一塊路牌：回程請沿燈光前進。"
    ],
    [
      "石柱間的雜音",
      "修理工 小禾",
      "這些石柱比電台更古老。卡匣靠近時會發熱，彷彿廢墟也記得昔日的聲音。",
      "石拱之間傳來短短三聲。那是舊時代表示平安的暗號。"
    ],
    [
      "最後一批貨物",
      "倉庫值班紀錄",
      "貨倉裡剩下未送出的收音機。搬運機仍照著停電前的排程，等待永遠沒到的列車。",
      "貨倉門開了。箱子上寫著：送往各島，讓大家能聽見彼此。"
    ]
  ],
