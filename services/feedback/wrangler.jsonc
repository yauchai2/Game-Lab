{
  "name": "game-lab-feedback",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "vars": { "ALLOWED_ORIGIN": "https://yauchai2.github.io" },
  "durable_objects": { "bindings": [{ "name": "FEEDBACK_GATE", "class_name": "FeedbackGate" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["FeedbackGate"] }],
  "ratelimits": [{ "name": "RATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }],
  "observability": { "enabled": false }
}
